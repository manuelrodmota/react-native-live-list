{
	"name": "react-native-live-list",
	"version": "0.1.2",
	"description": "Keep the on-screen rows of a React Native list live: one shared ticker, drift-free countdowns, and viewport-scoped realtime subscriptions.",
	"main": "./lib/commonjs/index.js",
	"module": "./lib/module/index.js",
	"types": "./lib/typescript/commonjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./lib/typescript/module/index.d.ts",
				"default": "./lib/module/index.js"
			},
			"require": {
				"types": "./lib/typescript/commonjs/index.d.ts",
				"default": "./lib/commonjs/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"lib",
		"!**/__tests__",
		"!**/*.test.*",
		"!**/.*"
	],
	"sideEffects": false,
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"clean": "del-cli lib",
		"build": "bob build",
		"prepack": "npm run clean && npm run build",
		"postversion": "git push --follow-tags"
	},
	"keywords": [
		"react-native",
		"expo",
		"countdown",
		"timer",
		"ticker",
		"realtime",
		"live-updates",
		"sse",
		"websocket",
		"flatlist",
		"flashlist",
		"viewability",
		"auction"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/manuelrodmota/react-native-live-list.git"
	},
	"bugs": {
		"url": "https://github.com/manuelrodmota/react-native-live-list/issues"
	},
	"homepage": "https://github.com/manuelrodmota/react-native-live-list#readme",
	"author": "Manuel Rodriguez",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-native": ">=0.71.0"
	},
	"devDependencies": {
		"@testing-library/react-native": "^13.0.0",
		"@types/jest": "^29.5.14",
		"@types/react": "~19.1.0",
		"del-cli": "^6.0.0",
		"jest": "^29.7.0",
		"prettier": "^3.6.0",
		"react": "19.1.0",
		"react-native": "0.81.5",
		"react-native-builder-bob": "^0.43.1",
		"react-test-renderer": "19.1.0",
		"typescript": "~5.9.0"
	},
	"react-native-builder-bob": {
		"source": "src",
		"output": "lib",
		"targets": [
			[
				"commonjs",
				{
					"esm": true
				}
			],
			[
				"module",
				{
					"esm": true
				}
			],
			[
				"typescript",
				{
					"project": "tsconfig.build.json"
				}
			]
		]
	}
}
